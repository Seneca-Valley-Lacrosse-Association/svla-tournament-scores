{
  "cleanUrls": true,
  "regions": ["cle1"],
  "crons": [{ "path": "/api/keepalive", "schedule": "0 15 */5 * *" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://svlacrosse.org https://www.svlacrosse.org" }
      ]
    }
  ]
}
